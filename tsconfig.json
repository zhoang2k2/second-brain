{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next",
        "dir": "./apps/web"
      }
    ],
    "paths": {
      "@zhon/contracts": ["./packages/contracts/src/index.ts"],
      "@/*": ["./apps/web/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "apps/runtime/**/*.ts",
    "apps/cli/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "apps/web/.next"]
}
